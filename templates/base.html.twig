<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
         {# --- Bootstrap CSS --- #}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
      
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

          <style>
      /* Styles spécifiques au footer sticky */
    html, body {
  height: 100%;
}
      body {
        margin-bottom: 60px; /* hauteur du footer */
        background-color: none !important;
          display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: none !important;
  margin: 0;
      }
 
    .footer {
  background-color: #f7f7f7;
  text-align: center;
  padding: 15px 0;
  border-top: 1px solid #e2e2e2;
}
      .dropdown-menu .divider {
        height: 1px;
        margin: 9px 0;
        overflow: hidden;
        background-color: #e5e5e5;
    }
    .card-body {
    flex: 1 1 auto;
    padding: var(--bs-card-spacer-y) var(--bs-card-spacer-x);
    color: var(--bs-card-color);
    border-color: #e2e2e2;
    color: #333;
    box-shadow: inset 0 1px #ffffff80;
    background: linear-gradient(#EFEFEF, #D4D4D4);
    }
    a {
    
    text-decoration: none;
    }
    .dropdown-header {
    color: #000;
    display: block;
    font-weight: 700;
    line-height: 1.42857;
    padding: 3px 20px;
}

.dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 1000;
    display: none;
    float: left;
    min-width: 160px;
    padding: 5px 0;
    margin: 2px 0 0;
    list-style: none;
    font-size: 14px;
    background-color: #fff;
    border: 1px solid #cccccc;
    border: 1px solid rgba(0, 0, 0, .15);
    border-radius: 4px;
    -webkit-box-shadow: 0 6px 12px rgba(0, 0, 0, .175);
    box-shadow: 0 6px 12px #0000002d;
    background-clip: padding-box;
}
.dropdown-menu>li>a
Spécificité : (0,1,2)
 {
    display: block;
    padding: 3px 20px;
    clear: both;
    font-weight: 400;
    line-height: 1.428571429;
    color: #333;
    white-space: nowrap;
}
.btn-group .dropdown-menu>li>a {
    font-size: 13px;
    padding-left: 20px
}

    </style>
       
        {% block stylesheets %}

        {% endblock %}

        {% block javascripts %}
         {# {% block importmap %}{{ importmap('app') }}{% endblock %} #}
        {% endblock %}   
    </head>
    <body>
     {# Navbar fixe en haut #}
     {% if app.user %}
    <nav class="navbar navbar-expand-md navbar-dark bg-dark fixed-top">
      <div class="container-fluid">
        <a class="navbar-brand" href="{{ path('app_home') }}"><b>BF AL DJAZAIR</b></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
          <ul class="navbar-nav me-auto mb-2 mb-md-0">
            <li class="nav-item">
              <a class="nav-link active" href="{{ path('app_home') }}">Accueil</a>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">Gestion de stock</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="{{ path('app_produit_index') }}">Produits</a></li>
                <li><a class="dropdown-item" href="{{ path('app_inventaire_index') }}">Inventaires</a></li>
                <li><a class="dropdown-item" href="#">Documents de stock</a></li>
                <li><a class="dropdown-item" href="{{path('app_entrepot_index')}}">Entrepôts</a></li>
                <li class="divider"></li>
                <li>
                  <a class="dropdown-item" href="#">
                    <div class="d-inline-flex align-items-center justify-content-center text-white rounded-circle" style="width:16px; height:16px; background:black;">
                      <i class="fa-solid fa-plus" style="font-size: 12px;"></i>
                    </div> Entrée
                  </a>
                </li>
                <li>
                  <a class="dropdown-item" href="#">
                    <div class="d-inline-flex align-items-center justify-content-center text-white rounded-circle" style="width:16px; height:16px; background:black;">
                      <i class="fa-solid fa-minus" style="font-size: 12px;"></i>
                    </div> Sortie
                  </a>
                </li>
              </ul>
            </li>
          </ul>

          <ul class="navbar-nav ms-auto">
            {# 🔒 Lien “Utilisateurs” visible seulement pour les admins #}
            {% if 'ROLE_ADMIN' in app.user.roles %}
              <li class="nav-item">
                <a class="nav-link" href="{{ path('app_user_index') }}">Utilisateurs</a>
              </li>
            {% endif %}

            <li class="nav-item dropdown">
             {% if app.user %}
                      <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                          {{ app.user.email }}
                      </a>
                      <ul class="dropdown-menu">
                          <li><a class="dropdown-item" href="{{ path('app_user_show', { id: app.user.id }) }}">Profil</a></li>
                          <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                      </ul>
                  {% else %}
                      <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
                  {% endif %}
            </li>
          </ul>
        </div>
      </div>
    </nav>
{% endif %}

      {# Contenu principal #}
   
        {% block body %}{% endblock %}
   

     {# Footer collé en bas #}
 <footer class="footer">
  <div class="container text-center">
    <span class="text-muted">© {{ "now"|date("Y") }} - BF AL DJAZAIR S.P.A</span>
  </div>
</footer>
        {# --- Bootstrap JS (bundle avec Popper) --- #}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
