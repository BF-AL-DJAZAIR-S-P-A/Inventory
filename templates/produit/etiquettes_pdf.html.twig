{% extends 'base_pdf.html.twig' %}

{% block title %}Étiquettes PDF{% endblock %}

{% block body %}
<style>
    @page {
        size: A4;
        margin: 0;
    }

    body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        background: #fff;
    }

    .page {
        width: 210mm;
        height: 297mm;
        padding-top: 8mm;
        padding-left: 6mm;
        padding-right: 6mm;
        box-sizing: border-box;
    }

    .table-etiquettes {
        border-collapse: collapse;
        width: 100%;
        table-layout: fixed;
    }

    .etiquette {
        width: 64.3mm;
        height: 70.5mm;
        border: 1px dashed transparent; /* mets #ccc pour visualiser les bordures */
        text-align: center;
        vertical-align: middle;
        box-sizing: border-box;
        padding: 2mm;
    }

    .etiquette img {
        display: block;
        margin: 0 auto;
        width: 90%;
        height: auto;
    }

    .product-name {
        font-size: 9pt;
        font-weight: normal;
        margin-bottom: 2mm;
        text-transform: uppercase;
        word-wrap: break-word;
        line-height: 1.1;
    }

    .code-article {
        font-size: 8pt;
        margin-top: 1mm;
        word-break: break-all;
    }
</style>

<div class="page">
    <table class="table-etiquettes">
        {% set compteur = 0 %}
        {% for item in produits %}
            {% for i in 1..item.quantite %}
                {% if compteur % 3 == 0 %}<tr>{% endif %}
                <td class="etiquette">
                    <div class="product-name">{{ item.produit.nom }}</div>
                    <img src="{{ path('produit_barcode', {id: item.produit.id}) }}" alt="Code-barres">
                    <div class="code-article">{{ item.produit.codeArticle }}</div>
                </td>
                {% set compteur = compteur + 1 %}
                {% if compteur % 3 == 0 %}</tr>{% endif %}
            {% endfor %}
        {% endfor %}

        {# si la dernière ligne n'est pas complète #}
        {% if compteur % 3 != 0 %}
            {% for j in 1..(3 - (compteur % 3)) %}
                <td class="etiquette"></td>
            {% endfor %}
            </tr>
        {% endif %}
    </table>
</div>
{% endblock %}
