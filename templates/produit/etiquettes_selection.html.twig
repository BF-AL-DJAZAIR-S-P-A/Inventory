{% extends 'base.html.twig' %}

{% block title %}Sélection Étiquettes{% endblock %}

{% block body %}
<h2>Sélection des produits pour impression d'étiquettes</h2>

<form method="POST" action="{{ path('produit_etiquettes_pdf') }}">
    <table border="1" cellpadding="5" cellspacing="0">
        <thead>
            <tr>
                <th>Produit</th>
                <th>Code Article</th>
                <th>Quantité d'étiquettes</th>
            </tr>
        </thead>
        <tbody>
        {% for produit in produits %}
            <tr>
                <td>{{ produit.nom }}</td>
                <td>{{ produit.codeArticle }}</td>
                <td>
                    <input type="number" name="quantite[{{ produit.id }}]" value="1" min="0">
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <button type="submit" style="margin-top: 10px;">Générer PDF</button>
</form>
{% endblock %}
