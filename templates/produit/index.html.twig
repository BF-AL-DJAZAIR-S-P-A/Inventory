{% extends 'base.html.twig' %}

{% block title %}Produit index{% endblock %}

{% block body %}
<style>
    body {
        padding-top: 56px;
    }

    .wrapper {
        display: flex;
        flex-direction: row;
        min-height: calc(100vh - 56px);
    }

    .content {
        flex: 1;
        padding: 20px;
    }

    /* --- Sidebar à gauche --- */
    .sidebar {
        width: 280px;
        background-color: #f7f7f7;
        border-right: 1px solid #ddd;
        padding: 15px;
        flex-shrink: 0;
        transition: transform 0.3s ease;
    }

    /* Bouton loupe (pour mobile) */
    .filter-toggle {
        position: fixed;
        top: 65px;
        left: 15px;
        z-index: 1050;
        background-color: #343a40;
        color: white;
        border: none;
        border-radius: 50%;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        cursor: pointer;
        display:none;
    }

    @media (max-width: 768px) {
        .sidebar {
            position: fixed;
            top: 56px;
            left: 0;
            height: calc(100% - 56px);
            transform: translateX(-100%);
            z-index: 1040;
        }

        .sidebar.active {
            transform: translateX(0);
            box-shadow: 3px 0 8px rgba(0, 0, 0, 0.2);
        }
        .filter-toggle{
            display:block;
        }
    }

    /* --- Bouton "Nouveau produit" --- */
    .btn-new-product {
        display: block;
        width: 100%;
        font-weight: bold;
        text-align: center;
        border: 1px solid #2480c2;
        color: #fff;
        text-shadow: rgba(0, 0, 0, .35) 0 1px 0;
        box-shadow: inset 0 1px #ffffff80;
        border-radius: 6px;
        padding: 10px 0;
        background: linear-gradient(#54b3ff, #0078d9);
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .btn-new-product:hover {
        background: linear-gradient(#66c1ff, #0088ff);
        box-shadow: 0 0 6px rgba(0, 120, 217, 0.5);
        text-decoration: none;
        color: #fff;
    }

    /* --- Bouton "Filtrer" --- */
    .btn-filter {
        font-size: 13px;
        border-radius: 4px;
        color: #333;
        padding: 6px 12px;
        text-align: center;
        box-shadow: 0 1px #fff3 inset, 0 1px #ccc;
        display: inline-block;
        border: 1px solid #e5e5e5;
        vertical-align: middle;
        cursor: pointer;
        background: linear-gradient(to bottom, white 0%, #eef0f1 100%);
        width: 100%;
    }

    .btn-filter:hover {
        background: linear-gradient(to bottom, #f9f9f9 0%, #e5e5e5 100%);
    }

    /* --- Table --- */
    .table thead>tr>th {
        border-bottom: 1px solid #dee3ea;
        padding-bottom: 11px !important;
        padding-top: 9px !important;
        background: linear-gradient(to bottom, #fff 0%, #f6f6f6 47%, #ededed 100%);
    }
</style>

<div class="wrapper">
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <a href="{{ path('app_produit_new') }}" class="btn-new-product mb-4">➕ Nouveau produit</a>

        <h5 class="mb-3">🔎 Recherche & filtres</h5>
        <form>
            <div class="mb-3">
                <label class="form-label">Nom du produit</label>
                <input type="text" class="form-control" placeholder="Rechercher...">
            </div>

            <div class="mb-3">
                <label class="form-label">Code article</label>
                <input type="text" class="form-control">
            </div>

            <div class="mb-3">
                <label class="form-label">Stock minimum</label>
                <input type="number" class="form-control">
            </div>

            <button type="submit" class="btn-filter">Rechercher</button>
        </form>
    </div>

    <!-- Contenu principal -->
    <div class="content pt-3">
        <h1 class="h2 mb-4">Liste des produits</h1>
          <div id="actions_dropdown_menu" class="btn-group pull-right" style="margin-top: 0px; position: relative;float: right;">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-cog"></i>
                        </a>
                        <ul class="dropdown-menu">
                            <li class="dropdown-header">Importer des Produits</li>
                            <li><a href="{{ path('produit_import') }}">Importer depuis Excel</a></li>
                            <li class="dropdown-divider"></li>
                            <li class="dropdown-header">Export</li>
                            <li><a href="#">Export vers Excel</a></li>
                            <li><a href="#">Export en CSV</a></li>
                            <li><a href="#" onclick="window.print(); return false;">Imprimer</a></li>
                            <li class="dropdown-divider"></li>
                            <li class="dropdown-header">Code-Barres</li>
                            <li><a href="{{ path('produit_etiquettes_selection') }}">Imprimer les codes barres</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Référence</th>
                    <th>Code Article</th>
                    <th>Code Barre</th>
                    <th>Stock Actuel</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for produit in produits %}
                <tr>
                    <td class="align-middle">
                        <img src="{{ asset('prod.png') }}" style="width:20px; margin-right:6px;">
                        {{ produit.nom }}
                    </td>
                     <td class="align-middle">{{ produit.reference }}</td>
                    <td class="align-middle">{{ produit.codeArticle }}</td>
                    <td class="align-middle">{{ produit.codeBarre }}</td>
                    <td class="align-middle">{{ produit.stockActuel }}</td>
                    <td class="align-middle">
                        <a href="{{ path('app_produit_show', {'id': produit.id}) }}">show</a>
                        <a href="{{ path('app_produit_edit', {'id': produit.id}) }}">edit</a>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5">Aucun produit trouvé</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Bouton loupe (mobile) -->
    <button class="filter-toggle" onclick="toggleSidebar()">
        <i class="fas fa-search"></i>
    </button>
</div>

<script>
    function toggleSidebar() {
        document.querySelector('.sidebar').classList.toggle('active');
    }
</script>
{% endblock %}
