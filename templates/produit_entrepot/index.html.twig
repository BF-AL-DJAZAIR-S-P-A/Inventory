{% extends 'base.html.twig' %}

{% block title %}ProduitEntrepot index{% endblock %}

{% block body %}
    <h1>ProduitEntrepot index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Quantite</th>
                <th>StockMinimum</th>
                <th>Actif</th>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for produit_entrepot in produit_entrepots %}
            <tr>
                <td>{{ produit_entrepot.id }}</td>
                <td>{{ produit_entrepot.quantite }}</td>
                <td>{{ produit_entrepot.stockMinimum }}</td>
                <td>{{ produit_entrepot.actif ? 'Yes' : 'No' }}</td>
                <td>{{ produit_entrepot.createdAt ? produit_entrepot.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ produit_entrepot.updatedAt ? produit_entrepot.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_produit_entrepot_show', {'id': produit_entrepot.id}) }}">show</a>
                    <a href="{{ path('app_produit_entrepot_edit', {'id': produit_entrepot.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_produit_entrepot_new') }}">Create new</a>
{% endblock %}
