{% extends 'base.html.twig' %}

{% block title %}Connexion | BF AL DJAZAIR{% endblock %}

{% block body %}
<style>
    body {
        background: linear-gradient(to right, #fff, #fff);
    }

    .login-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding-top: 80px; /* évite que la navbar cache le contenu */
        padding-bottom: 60px; /* laisse le footer visible */
    }

    .login-logo {
        width: auto;
        height: auto;
        margin-bottom: 25px;
    }

    .login-card {
        width: 100%;
        max-width: 400px;
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        background: white;
    }

    .login-card .card-header {
        background: #212529;
        color: white;
        font-weight: bold;
        text-align: center;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }

    .btn-login {
        background-color: #212529;
        border: none;
        transition: all 0.3s ease;
    }

    .btn-login:hover {
        background-color: #1e2124ff;
        transform: scale(1.02);
    }

    .form-label {
        font-weight: 600;
    }

    .footer {
        position: relative; /* empêche l’écrasement du contenu */
    }
</style>

<div class="login-container">
    <!-- Logo centré au-dessus du box -->
    <img src="{{ asset('logo.png') }}" alt="Logo BF ALDJAZAIR" class="login-logo">

    <div class="card login-card">
        <div class="card-header">
            <i class="fa-solid fa-right-to-bracket"></i> Connexion
        </div>
        <div class="card-body p-4">
            {% if error %}
                <div class="alert alert-danger">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="alert alert-info">
                    Vous êtes déjà connecté en tant que {{ app.user.userIdentifier }}.
                    <a href="{{ path('app_logout') }}" class="alert-link">Déconnexion</a>
                </div>
            {% else %}
                <form method="post">
                    <div class="mb-3">
                        <label for="username" class="form-label">Adresse e-mail</label>
                        <input type="email" value="{{ last_username }}" name="_username" id="username"
                            class="form-control" autocomplete="email" required autofocus>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Mot de passe</label>
                        <input type="password" name="_password" id="password"
                            class="form-control" autocomplete="current-password" required>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="d-grid">
                        <button class="btn btn-login text-white fw-bold" type="submit">
                            <i class="fa-solid fa-arrow-right-to-bracket"></i> Se connecter
                        </button>
                    </div>
                </form>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
